# 复制本文件为 .env 后按需修改；所有配置也可通过环境变量覆盖（前缀 REPOMIND_）

# 模型后端：online = 在线大模型，offline = 本地 Ollama
REPOMIND_LLM_PROVIDER=online

# 在线模型（OpenAI 兼容接口，DeepSeek / 智谱 / Kimi 等均可）
REPOMIND_ONLINE_MODEL=deepseek-chat
REPOMIND_ONLINE_API_KEY=sk-在这里填你的密钥
REPOMIND_ONLINE_BASE_URL=https://api.deepseek.com/v1

# 离线模型（需先安装 Ollama 并拉取模型，如 ollama pull qwen2.5:7b）
REPOMIND_OFFLINE_MODEL=qwen2.5:7b
REPOMIND_OLLAMA_BASE_URL=http://localhost:11434

# 向量模型：online 时跟随在线接口，offline 时使用 Ollama 同名嵌入模型
REPOMIND_EMBEDDING_PROVIDER=online
REPOMIND_EMBEDDING_MODEL=text-embedding-3-small
REPOMIND_OFFLINE_EMBEDDING_MODEL=nomic-embed-text

# 检索与分块参数
REPOMIND_CHUNK_SIZE=1200
REPOMIND_CHUNK_OVERLAP=150
REPOMIND_TOP_K=6
